---
import * as readme from "../../README.md";
import "../styles.css";

const title = readme.getHeadings().find((heading) => heading.depth === 1)?.text ?? "About Roomline";
const html = (await readme.compiledContent()).replace(/(src|href)="public\//g, '$1="/');
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="docs-page">
    <header class="site-header">
      <a class="brand" href="/" aria-label="Roomline home">
        <span class="brand-mark" aria-hidden="true"><span></span></span>
        <span><strong>Roomline</strong><small>ANU space finder</small></span>
      </a>
      <nav aria-label="Site navigation">
        <a href="/#results">Find a room</a>
        <a href="/#bookings">My bookings</a>
        <a class="nav-active" href="/readme/">About</a>
      </nav>
      <span class="prototype-label">Working prototype</span>
    </header>
    <main class="docs-content">
      <a class="back-link" href="/">← Back to room finder</a>
      <article set:html={html} />
    </main>
  </body>
</html>
